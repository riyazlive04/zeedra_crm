{
  "name": "sirah-zeedra-solar",
  "version": "1.0.0",
  "private": true,
  "description": "Sirah × Zeedra Solar — AI-powered CRM for solar installation companies. Built by Sirah Digital in collaboration with Zeedra Digital.",
  "author": "Sirah Digital × Zeedra Digital",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-test.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "test:ui": "node scripts/ui-check.mjs",
    "db:postgres": "node scripts/set-db-provider.mjs postgresql",
    "db:sqlite": "node scripts/set-db-provider.mjs sqlite",
    "vercel-build": "node scripts/set-db-provider.mjs postgresql && prisma generate && prisma migrate deploy && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "jose": "6.2.13",
    "leaflet": "1.9.4",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "playwright": "^1.56.1",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
