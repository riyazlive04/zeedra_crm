# ─── Core ────────────────────────────────────────────────────────────────
# SQLite for local/dev. For production use PostgreSQL (see docs/DEPLOYMENT.md).
DATABASE_URL="file:./dev.db"
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
APP_URL="http://localhost:3000"
# Business timezone for server-rendered dates (servers default to UTC).
APP_TIMEZONE="Asia/Kolkata"
# Shared secret for the scheduler that calls /api/cron/run (reminders, follow-ups, quote expiry)
CRON_SECRET="change-me-cron-secret"
# Shows one-click demo logins on the sign-in page. Never enable in production.
DEMO_MODE="false"

# ─── AI (Claude) ─────────────────────────────────────────────────────────
# Leave empty to run with the built-in rule engine (all features still work, AI narrative disabled).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ─── Google Calendar (OAuth 2.0, Web application client) ────────────────
# Authorized redirect URI: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── WhatsApp Cloud API (Meta) — per-organisation values are set in Settings → Integrations.
# Webhook verify token (used when registering {APP_URL}/api/webhooks/whatsapp in Meta):
WHATSAPP_VERIFY_TOKEN="change-me-verify-token"
# Optional: App secret to validate X-Hub-Signature-256 on inbound webhooks
WHATSAPP_APP_SECRET=""
